# Postgres (Neon)
DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/aggregate?sslmode=require

# Anthropic Claude API (scoring)
ANTHROPIC_API_KEY=sk-ant-...
SCORING_MODEL=claude-haiku-4-5

# Resend (email digest)
RESEND_API_KEY=re_...
DIGEST_FROM=Aggregate <bids@yourdomain.com>
DIGEST_TO=trevor@example.com,carlos@example.com

# NextAuth
NEXTAUTH_URL=http://localhost:6184
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Central Bidding (Playwright storage state — paste contents of auth-state.json)
CENTRAL_BIDDING_AUTH_STATE=

# Worker
NODE_ENV=development
